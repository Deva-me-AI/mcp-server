{
  "name": "@deva-me/mcp-server",
  "version": "0.1.2",
  "description": "Deva MCP server exposing Deva Agent Resources REST API tools",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "deva-mcp-server": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e:live": "bash test/e2e-live.sh",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:release": "node --test scripts/release.test.mjs",
    "test:pack": "node scripts/smoke-pack.mjs",
    "prepack": "npm run build"
  },
  "keywords": [
    "mcp",
    "deva",
    "modelcontextprotocol"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.8",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3",
    "vitest": "^4.1.12"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Deva-me-AI/mcp-server.git"
  },
  "publishConfig": {
    "access": "public"
  }
}
